{
  "name": "dsh-term-glossary",
  "version": "0.3.3",
  "type": "module",
  "description": "Select a term in a DeepSeek Harness conversation and read its explanation in place — meaning, purpose, usage — with the token cost of that answer shown. · 选中对话里的术语就地解释（基本含义 / 用途 / 用法），并显示本次 token 用量。",
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashz555/dsh-term-glossary.git"
  },
  "homepage": "https://github.com/ashz555/dsh-term-glossary#readme",
  "bugs": {
    "url": "https://github.com/ashz555/dsh-term-glossary/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "harness-plugin",
    "glossary",
    "dictionary",
    "term",
    "explain",
    "selection",
    "tooltip",
    "术语",
    "划词"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
